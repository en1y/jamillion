# One origin for the SPA, the API and Supabase, which is what makes CORS
# unnecessary: supabase-js is pointed at the page's own origin.
# Plain HTTP by default: a certificate for localhost means Caddy's own CA and a
# browser warning for a site nobody reaches from outside the machine. A real
# hostname -- SITE_ADDRESS=https://jamillion.example.com -- gets Let's Encrypt.
# The port lives in the compose mapping, not here: Caddy matches the site on the
# hostname and ignores the port the Host header carries.
{$SITE_ADDRESS:http://localhost} {
	handle /api/* {
		reverse_proxy backend:8080
	}
	# What supabase-js calls: sign-in, and the quiz_ceilings() RPC.
	handle_path /auth/v1/* {
		reverse_proxy auth:9999
	}
	handle_path /rest/v1/* {
		reverse_proxy rest:3000
	}
	# The anon key generated on first boot. Only public/ of the secrets volume is
	# mounted here, so nothing else in it can be served.
	handle /config.js {
		root * /srv/runtime
		header Cache-Control no-store
		file_server
	}
	handle {
		root * /srv
		# /editor/2026-09-11 is a client route, not a file.
		try_files {path} /index.html
		file_server
	}
}
