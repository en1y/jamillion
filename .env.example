# copy to .env and fill in. never commit .env

DATABASE_URL=postgresql://jamillion:jamillion@localhost:5432/jamillion
JWT_SECRET=change-me-to-a-long-random-string
PORT=8080

# first account ever registered becomes admin (DB trigger); these are only used
# by `scripts/create_admin.sh` if you want it created for you
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me

# https://developer.spotify.com/dashboard  (client credentials flow)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# https://console.cloud.google.com  -> YouTube Data API v3 -> API key
YOUTUBE_API_KEY=

# https://www.last.fm/api/account/create
LASTFM_API_KEY=

# where fetched audio snippets live
AUDIO_DIR=./data/audio
