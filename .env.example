# copy to .env and fill in. never commit .env

# ---- Supabase (local stack: npx supabase start prints all of these) ----
# `npx supabase status` reprints them at any time.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# the backend verifies Supabase's access tokens with this; it is NOT a secret we choose
SUPABASE_JWT_SECRET=
# Optional exact token issuer; default is SUPABASE_URL + /auth/v1.
# Local Supabase may issue http://127.0.0.1:54321/auth/v1 even when accessed via localhost.
SUPABASE_JWT_ISSUER=
# Enable when the frontend is served over HTTPS.
COOKIE_SECURE=false

# Public browser config (Vite reads the root .env). NEVER put a service-role key here.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=

# Postgres inside the Supabase stack. The scripts read DATABASE_URL, the backend PG*.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
PGHOST=127.0.0.1
PGPORT=54322
PGDATABASE=postgres
PGUSER=postgres
PGPASSWORD=postgres

PORT=8080

# The first account to sign up becomes the admin (database trigger on auth.users).

# ---- catalog sources ----
# https://www.last.fm/api/account/create   drives the top-500 ranking and listen counts
LASTFM_API_KEY=

# https://console.cloud.google.com -> YouTube Data API v3 -> API key. Adds view counts.
YOUTUBE_API_KEY=

# https://developer.spotify.com/dashboard  cross-reference ids only; Spotify no longer
# serves popularity, followers, genres or audio features to new apps.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Deezer, MusicBrainz and iTunes need no key.

# where fetched audio snippets live. The backend runs scripts/fetch_audio.py
# through .venv when a quiz first uses a track, so a relative path is resolved
# from the directory holding this file.
AUDIO_DIR=./data/audio
