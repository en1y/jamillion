# copy to .env and fill in. never commit .env

# ---- Supabase (local stack: npx supabase start prints all of these) ----
# `npx supabase status` reprints them at any time.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# the backend verifies Supabase's access tokens with this; it is NOT a secret we choose
SUPABASE_JWT_SECRET=
# Optional exact token issuer; default is SUPABASE_URL + /auth/v1.
# Local Supabase may issue http://127.0.0.1:54321/auth/v1 even when accessed via localhost.
SUPABASE_JWT_ISSUER=
# Enable when the frontend is served over HTTPS.
COOKIE_SECURE=false

# Public browser config (Vite reads the root .env). NEVER put a service-role key here.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=

# Postgres inside the Supabase stack. The scripts read DATABASE_URL, the backend PG*.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
PGHOST=127.0.0.1
PGPORT=54322
PGDATABASE=postgres
PGUSER=postgres
PGPASSWORD=postgres

PORT=8080

# ---- hardening (v0.10.0) ----
# RATE_LIMIT=off disables rate limiting entirely. The python integration suites
# need it off; hardening.py needs it on.
RATE_LIMIT=on
# Only these may claim to speak for someone else through X-Forwarded-For.
# The default is loopback plus Docker's bridge range, which is where Caddy sits.
# IPv4 only -- Drogon's RealIpResolver rejects an IPv6 entry at startup.
TRUST_PROXY_IPS=127.0.0.1,172.16.0.0/12
# Per minute. RATE_IP is the ceiling over all of /api; the rest are sub-limits.
RATE_IP=120
RATE_ME=10
RATE_LOOKUP=60
RATE_PLAY=40
RATE_IDEAS=5
RATE_CATALOG=60
# Largest accepted request body. POST /api/quizzes is the big one, a few tens of kB.
MAX_BODY_BYTES=262144
# Seconds a query may wait for a connection before it fails. 0 is Drogon's own
# default and means forever: a database that is down then hangs every route.
DB_TIMEOUT_SEC=5

# ---- docker compose ----
# Compose needs none of this file: secrets are generated on first boot and the
# catalog keys are entered on the setup page. The one thing it reads is the
# address Caddy serves -- localhost gets its internal CA, a real hostname gets
# Let's Encrypt.
DOMAIN=localhost
# Where the backend's startup summary says to open the app. Compose sets
# https://$DOMAIN; in development it is Vite.
PUBLIC_URL=http://localhost:5173
# Where the backend keeps the keys entered on the setup page (0600).
# Development can leave them in the catalog section below instead.
CONFIG_DIR=./data/config
# How many days of dumps scripts/backup.sh keeps.
BACKUP_KEEP_DAYS=14

# The first account to sign up becomes the admin (database trigger on auth.users).

# ---- catalog sources ----
# https://www.last.fm/api/account/create   drives the top-500 ranking and listen counts
LASTFM_API_KEY=

# https://console.cloud.google.com -> YouTube Data API v3 -> API key. Adds view counts.
YOUTUBE_API_KEY=

# https://developer.spotify.com/dashboard  cross-reference ids only; Spotify no longer
# serves popularity, followers, genres or audio features to new apps.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Deezer, MusicBrainz and iTunes need no key.

# where fetched audio snippets live. The backend runs scripts/fetch_audio.py
# through .venv when a quiz first uses a track, so a relative path is resolved
# from the directory holding this file.
AUDIO_DIR=./data/audio
